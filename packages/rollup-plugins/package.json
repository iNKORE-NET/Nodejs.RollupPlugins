{
    "name": "@inkore/rollup-plugins",
    "description": "A collection of some commonly used rollup plugins.",
    "version": "0.2.0",
    "author": "notyoojun",
    "license": "LGPL-2.1-or-later",
    "keywords": 
    [
        "rollup-plugin",
        "rollup",
        "inkore",
        "plugin"
    ],
    "publishConfig": 
    {
        "access": "public"
    },
    "type": "module",
    "types": "dist/index.d.ts",
    "module": "dist/index.js",
    "exports": 
    {
        ".": 
        {
            "default": "./dist/index.js",
            "types": "./dist/types/index.d.ts"
        },
        "./utilities": 
        {
            "default": "./dist/utilities/index.js",
            "types": "./dist/utilities/index.d.ts"
        },
        "./utilities/*": 
        {
            "default": "./dist/utilities/*.js",
            "types": "./dist/utilities/*.d.ts"
        },
        "./plugins/*": 
        {
            "default": "./dist/plugins/*.js",
            "types": "./dist/plugins/*.d.ts"
        },
        "./*": 
        {
            "default": "./dist/plugins/*.js",
            "types": "./dist/plugins/*.d.ts"
        }
    },
    "repository": 
    {
        "type": "git",
        "url": "https://github.com/iNKORE-Public/Rollup.Plugins"
    },
    "homepage": "https://github.com/iNKORE-Public/Rollup.Plugins#readme",
    "bugs": "https://github.com/iNKORE-Public/Rollup.Plugins/issues",
    "scripts": 
    {
        "check": "tsc",
        "dev": "rollup -c rollup.config.mjs -w"
    },
    "peerDependencies": 
    {
        "glob": "^10.3.15",
        "javascript-obfuscator": "^4.1.0",
        "postcss": "^8.4.38",
        "postcss-modules": "^6.0.0",
        "rollup": "2.x || 3.x || 4.x",
        "sass": "^1.77.1"
    },
    "peerDependenciesMeta": 
    {
        "postcss": 
        {
            "optional": true
        },
        "postcss-modules": 
        {
            "optional": true
        },
        "sass": 
        {
            "optional": true
        }
    },
    "dependencies": 
    {
        "@niceties/logger": "^1.1.13",
        "@rollup/pluginutilities": "^5.1.0",
        "acorn": "^8.11.3",
        "acorn-typescript": "^1.4.13",
        "acorn-walk": "^8.3.3",
        "colorette": "^2.0.20",
        "estree-walker": "^3.0.3",
        "fs-extra": "^11.2.0",
        "globby": "^14.0.1",
        "is-plain-object": "^5.0.0",
        "magic-string": "^0.30.5",
        "perf-regexes": "^1.0.1",
        "rimraf": "^5.0.5",
        "skip-regex": "^1.0.2"
    },
    "devDependencies": 
    {
        "@swc/core": "^1.10.7",
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^20.12.5",
        "@typescript-eslint/eslint-plugin": "^6.13.2",
        "@typescript-eslint/parser": "^6.13.2",
        "@typescript-eslint/typescript-estree": "^7.2.0",
        "eslint": "^8.55.0",
        "eslint-config-airbnb": "^19.0.4",
        "eslint-config-airbnb-typescript": "^17.1.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-import-resolver-typescript": "^3.6.1",
        "eslint-plugin-import": "^2.29.0",
        "eslint-plugin-jsx-a11y": "^6.8.0",
        "eslint-plugin-perfectionist": "^2.5.0",
        "eslint-plugin-prettier": "^5.0.1",
        "eslint-plugin-react": "^7.33.2",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-unused-imports": "^3.0.0",
        "glob": "^10.3.15",
        "prettier": "^3.1.0",
        "rollup": "^4.9.5",
        "tsup": "^8.0.1",
        "typescript": "^5.3.3"
    },
    "files": 
    [
        "dist",
        "src/**/*",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ]
}