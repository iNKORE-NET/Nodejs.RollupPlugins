{
    "name": "@inkore/rollup-plugins",
    "description": "A collection of some commonly used rollup plugins.",
    "version": "0.3.0",
    "scripts": 
    {
        "check": "tsc",
        "dev": "rollup -c rollup.config.mjs --watch --environment MODE:dev",
        "build": "rollup -c rollup.config.mjs --environment MODE:prod"
    },
    "keywords": 
    [
        "rollup-plugin",
        "rollup",
        "inkore",
        "plugin"
    ],
    "publishConfig": 
    {
        "access": "public"
    },
    "type": "module",
    "types": "dist/index.d.ts",
    "module": "dist/index.js",
    "exports": 
    {
        ".": 
        {
            "default": "./dist/index.js",
            "types": "./dist/types/index.d.ts"
        },
        "./utilities": 
        {
            "default": "./dist/utilities/index.js",
            "types": "./dist/utilities/index.d.ts"
        },
        "./utilities/*": 
        {
            "default": "./dist/utilities/*.js",
            "types": "./dist/utilities/*.d.ts"
        },
        "./plugins/*": 
        {
            "default": "./dist/plugins/*.js",
            "types": "./dist/plugins/*.d.ts"
        },
        "./*": 
        {
            "default": "./dist/plugins/*.js",
            "types": "./dist/plugins/*.d.ts"
        }
    },
    "repository": 
    {
        "type": "git",
        "url": "https://github.com/iNKORE-NET/Rollup.Plugins"
    },
    "homepage": "https://docs.inkore.net/rollup-plugins",
    "bugs": "https://github.com/iNKORE-NET/Rollup.Plugins/issues",
    "peerDependencies": 
    {
        "glob": "^10.3.15",
        "javascript-obfuscator": "^4.1.0",
        "postcss": "^8.4.38",
        "postcss-modules": "^6.0.0",
        "rollup": "2.x || 3.x || 4.x",
        "sass": "^1.77.1"
    },
    "peerDependenciesMeta": 
    {
        "postcss": 
        {
            "optional": true
        },
        "postcss-modules": 
        {
            "optional": true
        },
        "sass": 
        {
            "optional": true
        }
    },
    "dependencies": 
    {
        "@niceties/logger": "^1.1.13",
        "@rollup/pluginutils": "^5.1.0",
        "acorn": "^8.11.3",
        "acorn-typescript": "^1.4.13",
        "acorn-walk": "^8.3.3",
        "colorette": "^2.0.20",
        "estree-walker": "^3.0.3",
        "fs-extra": "^11.2.0",
        "globby": "^14.0.1",
        "is-plain-object": "^5.0.0",
        "magic-string": "^0.30.5",
        "perf-regexes": "^1.0.1",
        "rimraf": "^5.0.5",
        "skip-regex": "^1.0.2"
    },
    "files": 
    [
        "dist",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "author": "notyoojun",
    "license": "LGPL-2.1-or-later"
}